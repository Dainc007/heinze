{% extends "layout.njk" %}
{% from "partials/icons.njk" import arrow, ball %}
{% from "partials/project-card.njk" import featured, card %}

{% block body %}
{% include "partials/header.njk" %}

<main id="content">

    {# HERO #}
    <section class="mx-auto flex max-w-6xl flex-wrap items-center gap-12 px-6 pt-14 pb-20 md:pt-20 lg:gap-14">
        <div class="min-w-0 flex-[999_1_560px]">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs tracking-wider text-muted uppercase">
                <span>{{ t.hero.eyebrow }}</span>
                {% if site.available %}
                <span class="inline-flex items-center gap-2 rounded-full border border-ink-800 bg-ink-900 px-3 py-1 normal-case tracking-normal">
                    <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-accent"></span></span>
                    {{ t.hero.available }}
                </span>
                {% endif %}
            </p>
            <h1 class="mt-6 text-balance font-display text-[clamp(2.5rem,6vw,4rem)] leading-[1.04] font-semibold tracking-[-0.035em]">
                {{ t.hero.title }}
                {# Typed endings. All phrases share one grid cell, so the slot is as wide as the longest one and the headline never reflows. #}
                <span x-data="headlineTyper" class="inline-grid max-w-full text-accent">
                    {% for phrase in t.hero.titlePhrases %}
                    <span data-phrase class="invisible col-start-1 row-start-1 sm:whitespace-nowrap" aria-hidden="true">{{ phrase }}</span>
                    {% endfor %}
                    <span class="col-start-1 row-start-1 sm:whitespace-nowrap" aria-hidden="true"><span x-ref="text">{{ t.hero.titlePhrases[0] }}</span><span x-ref="caret" class="headline-caret is-idle"></span></span>
                    <span class="sr-only">{{ t.hero.titlePhrases[0] }}</span>
                </span>
            </h1>
            <p class="mt-7 max-w-[36rem] text-lg/relaxed text-muted sm:text-[19px]">{{ t.hero.lead }}</p>
            <div class="mt-9 flex flex-wrap gap-3">
                <a href="#work" class="btn-primary">{{ t.hero.primary }}</a>
                <a href="#contact" class="btn-secondary">{{ t.hero.secondary }}</a>
            </div>
        </div>
        <div x-data="typewriter" class="w-full max-w-[470px] min-w-0 flex-[1_1_340px] overflow-hidden rounded-[18px] border border-ink-800 bg-ink-900">
            <div class="flex items-center gap-2 border-b border-ink-800 px-4 py-3">
                <span class="size-2.5 rounded-full bg-ink-700"></span><span class="size-2.5 rounded-full bg-ink-700"></span><span class="size-2.5 rounded-full bg-ink-700"></span>
                <span class="ml-2 font-mono text-xs text-muted">daniel@heinze: ~</span>
            </div>
            <div class="grid gap-1.5 p-5 font-mono text-[13px]/relaxed sm:text-sm/relaxed" role="img" aria-label="{{ t.hero.terminalLabel }}">
                {% for step in t.hero.terminal %}
                <p data-row="cmd" class="{{ '' if loop.first else 'mt-3' }}"><span class="text-accent">$</span> <span data-type>{{ step.cmd }}</span></p>
                {% for line in step.out %}
                <p data-row="out" class="whitespace-pre-wrap text-muted">{{ line }}</p>
                {% endfor %}
                {% endfor %}
                <p data-row="prompt" class="mt-3"><span class="text-accent">$</span> <span x-ref="cursor" class="term-cursor inline-block h-[1.1em] w-[0.6em] translate-y-[0.15em] bg-accent" aria-hidden="true"></span></p>
            </div>
        </div>
    </section>

    {# WORK #}
    <section id="work" aria-labelledby="work-title" class="mx-auto max-w-6xl px-6 py-14">
        <div class="mb-10 flex flex-wrap items-baseline justify-between gap-4">
            <h2 id="work-title" class="section-title">{{ t.work.title }}</h2>
            <p class="text-muted">{{ t.work.subtitle }}</p>
        </div>

        <div class="grid gap-6">
            {% for p in site.projects %}{% if p.featured %}
            {{ featured(p, t.work.projects[p.id], t) }}
            {% endif %}{% endfor %}
        </div>

        <h3 class="mt-16 font-mono text-xs tracking-widest text-muted uppercase">{{ t.work.clients }}</h3>
        <div class="mt-4 grid gap-6 md:grid-cols-2">
            {% for p in site.projects %}{% if not p.featured %}
            {{ card(p, t.work.projects[p.id], t) }}
            {% endif %}{% endfor %}
        </div>

        <h3 class="mt-14 mb-3 font-mono text-xs tracking-widest text-muted uppercase">{{ t.work.more }}</h3>
        <ul class="grid border-t border-ink-800 md:grid-cols-2 md:gap-x-10">
            {% for p in site.moreProjects %}
            {% set tp = t.work.moreProjects[p.id] %}
            <li class="border-b border-ink-800">
                <a href="{{ p.url }}" class="group flex min-h-12 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
                    <span class="font-medium group-hover:text-accent">{{ tp.title }}</span>
                    <span class="inline-flex items-center gap-2 font-mono text-xs text-muted">{{ tp.note }} {{ arrow("size-3.5") }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </section>

    {# TESTIMONIALS (shown once site.json has some) #}
    {% if site.testimonials | length %}
    <section id="testimonials" aria-labelledby="testimonials-title" class="mx-auto max-w-6xl px-6 py-14">
        <h2 id="testimonials-title" class="section-title mb-10">{{ t.testimonials.title }}</h2>
        <div class="grid gap-6 md:grid-cols-2">
            {% for item in site.testimonials %}
            <figure class="rounded-[18px] border border-ink-800 bg-ink-900 p-7">
                <blockquote class="text-lg">“{{ t.testimonials.quotes[item.id] }}”</blockquote>
                <figcaption class="mt-4 text-sm text-muted">{{ item.name }} · {{ item.company }}</figcaption>
            </figure>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ABOUT + EXPERIENCE #}
    <section id="about" aria-labelledby="about-title" class="mx-auto flex max-w-6xl flex-wrap gap-12 px-6 py-14">
        <div class="flex-[1_1_320px]">
            <h2 id="about-title" class="section-title mb-5">{{ t.about.title }}</h2>
            <div class="max-w-md space-y-4 text-muted">
                {% for paragraph in t.about.body %}<p>{{ paragraph }}</p>{% endfor %}
            </div>
        </div>
        <div class="min-w-0 flex-[999_1_560px]">
            <ol class="border-b border-ink-800">
                {% for job in site.experience %}
                {% set tj = t.about.jobs[job.id] %}
                <li class="flex flex-wrap gap-x-6 gap-y-1 border-t border-ink-800 py-5">
                    <span class="flex-[0_0_9.5rem] pt-0.5 font-mono text-sm text-muted">{{ tj.dates }}</span>
                    <div class="flex-[1_1_18rem]">
                        <p class="font-medium">
                            {{ tj.role }}{% if tj.company %} ·
                            {% if job.url %}<a href="{{ job.url }}" class="text-accent hover:underline">{{ tj.company }}</a>{% else %}{{ tj.company }}{% endif %}
                            {% endif %}
                        </p>
                        <p class="mt-0.5 text-muted">{{ tj.text }}</p>
                    </div>
                </li>
                {% endfor %}
            </ol>
            <h3 class="mt-8 mb-3 font-mono text-xs tracking-widest text-muted uppercase">{{ t.about.stack }}</h3>
            <ul class="flex flex-wrap gap-2">
                {% for tech in site.stack %}<li class="tag">{{ tech }}</li>{% endfor %}
            </ul>
        </div>
    </section>

    {# AFTER HOURS: a match ticket, a "now playing" card and a trail profile #}
    {% set a = t.after %}
    <section id="after" aria-labelledby="after-title" class="mx-auto max-w-6xl px-6 py-14">
        <h2 id="after-title" class="section-title mb-8">{{ a.title }}</h2>
        <div class="grid gap-5 md:grid-cols-3">

            {# Football: a matchday ticket #}
            <article class="ticket relative flex min-h-56 overflow-hidden rounded-[18px] bg-arsenal text-white md:col-span-2">
                <div class="flex min-w-0 flex-1 flex-col justify-between gap-8 p-6 sm:p-8">
                    <p class="font-mono text-xs tracking-[0.2em] uppercase opacity-90">{{ a.arsenal.label }}</p>
                    <div>
                        <h3 class="font-display text-[clamp(2.5rem,7vw,4rem)] leading-none font-bold tracking-[-0.03em]">{{ a.arsenal.title }}</h3>
                        <p class="mt-3 max-w-sm opacity-90">{{ a.arsenal.text }}</p>
                    </div>
                </div>
                <div class="ticket-stub relative flex w-28 shrink-0 flex-col justify-between border-l-2 border-dashed border-white/40 p-4 font-mono text-[11px] uppercase sm:w-40 sm:p-6">
                    <p class="tracking-[0.2em] opacity-90">{{ a.arsenal.admit }}</p>
                    <dl class="grid gap-3">
                        <div><dt class="opacity-75">{{ a.arsenal.seatLabel }}</dt><dd class="text-sm font-semibold normal-case">{{ a.arsenal.seat }}</dd></div>
                        <div><dt class="opacity-75">{{ a.arsenal.seasonLabel }}</dt><dd class="text-sm font-semibold">{{ a.arsenal.season }}</dd></div>
                    </dl>
                </div>
            </article>

            {# Gaming: now playing #}
            <article class="flex flex-col justify-between gap-8 rounded-[18px] border border-ink-800 bg-ink-900 p-6 sm:p-7">
                <p class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-accent uppercase">
                    <span class="eq" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                    {{ a.proclubs.label }}
                </p>
                <div>
                    <h3 class="font-display text-2xl font-semibold tracking-tight">{{ a.proclubs.title }}</h3>
                    <p class="mt-2 text-muted">{{ a.proclubs.text }}</p>
                    <a href="{{ site.links.onside }}" class="mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-accent hover:underline">{{ a.proclubs.link }} {{ arrow("size-4") }}</a>
                </div>
            </article>

            {# Offline: a trail elevation profile #}
            <article class="relative overflow-hidden rounded-[18px] border border-ink-800 bg-ink-900 md:col-span-3">
                <div class="relative z-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-2 p-6 pb-24 sm:p-8 sm:pb-28">
                    <div>
                        <p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">{{ a.outdoors.label }}</p>
                        <h3 class="mt-3 font-display text-2xl font-semibold tracking-tight">{{ a.outdoors.title }}</h3>
                    </div>
                    <p class="max-w-sm text-muted">{{ a.outdoors.text }}</p>
                </div>
                <svg class="absolute inset-x-0 bottom-0 h-24 w-full sm:h-28" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M0 120V96L70 80 120 88 190 52 240 66 300 30 350 46 410 18 470 50 520 40 580 72 640 58 700 26 760 44 820 36 880 70 940 60 1000 78V120Z" fill="var(--color-accent)" fill-opacity="0.08"/>
                    <path d="M0 96L70 80 120 88 190 52 240 66 300 30 350 46 410 18 470 50 520 40 580 72 640 58 700 26 760 44 820 36 880 70 940 60 1000 78" fill="none" stroke="var(--color-accent)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>
                    <circle cx="410" cy="18" r="4" fill="var(--color-accent)"/>
                </svg>
            </article>
        </div>
    </section>

    {# CONTACT #}
    <section id="contact" aria-labelledby="contact-title" class="mx-auto max-w-6xl px-6 pt-14 pb-16">
        <h2 id="contact-title" class="sr-only">{{ t.contact.title }}</h2>
        <div class="flex flex-wrap items-end justify-between gap-8 rounded-3xl border border-ink-800 bg-ink-900 px-7 py-12 sm:px-12 sm:py-14">
            <div class="min-w-0 flex-[1_1_420px]">
                <p class="mb-3 text-muted">{{ t.contact.lead }}</p>
                <a href="mailto:{{ site.email }}" class="font-display text-[clamp(1.5rem,4.5vw,2.75rem)] leading-tight font-semibold tracking-[-0.03em] break-words text-accent hover:underline">{{ site.email }}</a>
            </div>
            <ul class="flex flex-wrap gap-x-6 gap-y-3 text-[15px]">
                <li><a href="{{ site.links.github }}" class="inline-flex min-h-11 items-center gap-1 hover:text-accent">GitHub {{ arrow("size-3.5") }}</a></li>
                <li><a href="{{ site.links.linkedin }}" class="inline-flex min-h-11 items-center gap-1 hover:text-accent">LinkedIn {{ arrow("size-3.5") }}</a></li>
                <li><a href="{{ site.links.useme }}" class="inline-flex min-h-11 items-center gap-1 hover:text-accent">Useme {{ arrow("size-3.5") }}</a></li>
            </ul>
        </div>
    </section>
</main>

<footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-5 border-t border-ink-800 px-6 pt-6 pb-10 text-sm text-muted">
    <div>
        <p>© {{ year }} {{ site.name }}</p>
        <p class="mt-1 text-xs">{{ t.footer.built }}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <span>{{ t.footer.support }}</span>
        <a href="{{ site.support.beer }}" class="text-fg hover:text-accent">{{ t.footer.beer }}</a>
        <a href="{{ site.support.patronite }}" class="text-fg hover:text-accent">{{ t.footer.patronite }}</a>
    </div>
    <div x-data="ball" class="flex items-center gap-3">
        <button type="button" @click="kick()" aria-label="{{ t.footer.kick }}" title="{{ t.footer.kick }}" class="relative flex h-11 w-24 items-center rounded-full border border-ink-800 px-2 hover:border-ink-700">
            <span class="inline-flex" :class="kicking && 'ball-kicked'">{{ ball("size-6") }}</span>
            <span aria-hidden="true" class="absolute top-1/2 right-2 h-6 w-3 -translate-y-1/2 rounded-r border-2 border-l-0 border-muted/60"></span>
        </button>
        <span class="font-mono text-xs" aria-live="polite">{{ t.footer.goals }}: <span x-text="goals">0</span></span>
    </div>
</footer>
{% endblock %}
