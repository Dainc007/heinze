{% from "partials/icons.njk" import menu, close %}
{# Top bar: logo, section links, language switch. On phones the links fold into a menu. #}
<header x-data="{ open: false }" @keydown.escape.window="open = false" class="sticky top-0 z-30 border-b border-transparent bg-ink-950/85 backdrop-blur" :class="{ 'border-ink-800!': open }">
    <div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-6">
        <a href="{{ url }}" class="font-display text-xl font-bold tracking-tight">heinze<span class="text-accent">.</span></a>

        <nav aria-label="{{ t.menu }}" class="hidden items-center gap-7 text-[15px] md:flex">
            {% for id in site.sections %}
            <a href="#{{ id }}" class="nav-link" :class="{ 'is-active': active === '{{ id }}' }">{{ t.nav[id] }}</a>
            {% endfor %}
            {% include "partials/lang-switch.njk" %}
        </nav>

        <div class="flex items-center gap-3 md:hidden">
            {% include "partials/lang-switch.njk" %}
            <button type="button" @click="open = !open" :aria-expanded="open.toString()" aria-controls="mobile-menu" class="flex size-11 items-center justify-center rounded-full border border-ink-700">
                <span class="sr-only">{{ t.menu }}</span>
                <span x-show="!open">{{ menu() }}</span>
                <span x-show="open" x-cloak>{{ close() }}</span>
            </button>
        </div>
    </div>

    <nav id="mobile-menu" x-show="open" x-cloak @click.outside="open = false" aria-label="{{ t.menu }}" class="mx-auto max-w-6xl px-6 pb-4 md:hidden">
        <ul class="grid gap-1">
            {% for id in site.sections %}
            <li><a href="#{{ id }}" @click="open = false" class="flex min-h-11 items-center rounded-lg px-3 text-muted hover:bg-ink-900 hover:text-fg" :class="{ 'text-fg': active === '{{ id }}' }">{{ t.nav[id] }}</a></li>
            {% endfor %}
        </ul>
    </nav>
</header>
