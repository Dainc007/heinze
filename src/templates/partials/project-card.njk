{#
    Project building blocks. Usage:
    {% from "partials/project-card.njk" import featured, card %}
    {{ featured(p, t.work.projects[p.id], t) }}   big card with a browser-framed screenshot
    {{ card(p, t.work.projects[p.id], t) }}       client project card
#}

{% macro arrowIcon(class) %}<svg class="{{ class }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>{% endmacro %}

{# Screenshot inside a simple browser window. Without `image` it shows a labelled placeholder. #}
{% macro frame(p, tp, t) %}
<div class="overflow-hidden rounded-xl border border-ink-700 bg-ink-950 shadow-[0_24px_60px_-30px_rgb(0_0_0/0.9)]">
    <div class="flex items-center gap-1.5 border-b border-ink-800 px-3 py-2.5">
        <span class="size-2 rounded-full bg-ink-700"></span><span class="size-2 rounded-full bg-ink-700"></span><span class="size-2 rounded-full bg-ink-700"></span>
        <span class="ml-2 truncate rounded bg-ink-900 px-2.5 py-0.5 font-mono text-[11px] text-muted">{{ p.domain }}</span>
    </div>
    {% if p.image %}
    <img src="{{ p.image }}" alt="{{ tp.title }}" loading="lazy" class="aspect-[16/10] w-full object-cover object-top">
    {% else %}
    <div class="grid aspect-[16/10] place-items-center p-6 text-center">
        <div>
            <p class="font-display text-2xl font-semibold tracking-tight">{{ tp.title }}</p>
            <p class="mt-1 font-mono text-xs text-muted">{{ t.work.screenshotSoon }}</p>
        </div>
    </div>
    {% endif %}
</div>
{% endmacro %}

{% macro featured(p, tp, t) %}
<article class="grid overflow-hidden rounded-[20px] border border-ink-800 bg-ink-900 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
    <div class="flex flex-col p-6 sm:p-9">
        <p class="font-mono text-xs tracking-wide text-accent uppercase">{{ tp.kind }}</p>
        <h3 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">{{ tp.title }}</h3>
        <p class="mt-3 text-muted">{{ tp.text }}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
            {% for tech in p.stack %}<li class="tag">{{ tech }}</li>{% endfor %}
        </ul>
        {% if p.url %}
        <a href="{{ p.url }}" class="mt-8 inline-flex min-h-11 items-center gap-2 self-start rounded-full border border-ink-700 px-5 text-sm font-medium transition hover:border-accent hover:text-accent">
            {{ t.work.visit }} {{ p.domain }} {{ arrowIcon("size-4") }}
        </a>
        {% endif %}
    </div>
    <div class="border-t border-ink-800 bg-ink-950/60 p-4 sm:p-6 md:border-t-0 md:border-l md:p-8">
        {{ frame(p, tp, t) }}
    </div>
</article>
{% endmacro %}

{# Client project card: screenshot on top, text below. The whole card is the link. #}
{% macro card(p, tp, t) %}
<article class="group relative flex flex-col overflow-hidden rounded-[18px] border border-ink-800 bg-ink-900 transition hover:border-ink-700">
    <img src="{{ p.image }}" alt="{{ tp.title }}" loading="lazy" class="aspect-video w-full border-b border-ink-800 object-cover object-top">
    <div class="flex flex-1 flex-col p-6 sm:p-7">
        <p class="font-mono text-xs tracking-wide text-accent uppercase">{{ tp.kind }}</p>
        <h4 class="mt-2 font-display text-2xl font-semibold tracking-tight">
            {% if p.url %}
            <a href="{{ p.url }}" class="inline-flex items-center gap-1.5 after:absolute after:inset-0 group-hover:text-accent">{{ tp.title }}{{ arrowIcon("size-5") }}</a>
            {% else %}{{ tp.title }}{% endif %}
        </h4>
        <p class="mt-2 text-muted">{{ tp.text }}</p>
        <ul class="mt-auto flex flex-wrap gap-2 pt-5">
            {% for tech in p.stack %}<li class="tag">{{ tech }}</li>{% endfor %}
        </ul>
    </div>
</article>
{% endmacro %}
