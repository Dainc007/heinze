{# Small inline icons. Usage: {% from "partials/icons.njk" import arrow %} … {{ arrow() }} #}

{% macro arrow(class="size-4") %}
<svg class="{{ class }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
{% endmacro %}

{% macro menu(class="size-5") %}
<svg class="{{ class }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
{% endmacro %}

{% macro close(class="size-5") %}
<svg class="{{ class }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"/></svg>
{% endmacro %}

{% macro mail(class="size-4") %}
<svg class="{{ class }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2"/><path d="m3 5.5 7 5.5 7-5.5"/></svg>
{% endmacro %}

{% macro ball(class="size-6") %}
<svg class="{{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#f2f2f0" stroke="#0b0c0e"/><path d="m12 8 3.3 2.4-1.3 3.8h-4l-1.3-3.8z" fill="#0b0c0e" stroke="#0b0c0e"/><path d="M12 8V2.5M15.3 10.4l5-1.8M14 14.2l3 4.5M10 14.2l-3 4.5M8.7 10.4l-5-1.8" stroke="#0b0c0e"/></svg>
{% endmacro %}
